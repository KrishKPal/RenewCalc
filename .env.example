# Backend (for local Python or Docker)
RENEWCALC_DB_PATH=.local/renewcalc.db
RENEWCALC_CACHE_DIR=.cache/renewcalc
RENEWCALC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend: Next.js server-side proxy target. Copy into frontend/.env.local
RENEWCALC_BACKEND_URL=http://127.0.0.1:8000
